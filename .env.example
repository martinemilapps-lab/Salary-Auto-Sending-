# Meta WhatsApp Business Cloud API Credentials
# Retrieve these credentials from your Meta Developer App Dashboard
# https://developers.facebook.com/apps/

WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_API_VERSION=v21.0

# Meta WhatsApp Template Configuration
# The approved utility template name in Meta WhatsApp Business Manager
WHATSAPP_TEMPLATE_NAME=salary_statement
# The exact language code configured for the template in Meta (e.g. en or en_US)
WHATSAPP_TEMPLATE_LANGUAGE_CODE=en
