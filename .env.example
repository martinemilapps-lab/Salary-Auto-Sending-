# Meta WhatsApp Business Cloud API Credentials
# Retrieve these credentials from your Meta Developer App Dashboard
# https://developers.facebook.com/apps/

WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_API_VERSION=v21.0

# Meta WhatsApp Template Configuration: Module 1 — Weekly Statement (البيان الأسبوعي)
# Approved utility template name in Meta WhatsApp Business Manager (16 parameters)
WHATSAPP_WEEKLY_TEMPLATE_NAME=salary_weekly_statement
# Exact language code configured for the weekly template in Meta (e.g. ar or en)
WHATSAPP_WEEKLY_TEMPLATE_LANGUAGE_CODE=ar

# Meta WhatsApp Template Configuration: Module 2 — Monthly Statement (البيان الشهري)
# Approved utility template name in Meta WhatsApp Business Manager (16 parameters)
WHATSAPP_MONTHLY_TEMPLATE_NAME=salary_monthly_statement
# Exact language code configured for the monthly template in Meta (e.g. ar or en)
WHATSAPP_MONTHLY_TEMPLATE_LANGUAGE_CODE=ar

# Legacy template fallback (optional backward compatibility)
WHATSAPP_TEMPLATE_NAME=salary_statement
WHATSAPP_TEMPLATE_LANGUAGE_CODE=ar
